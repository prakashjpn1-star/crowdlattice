{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/crowdlattice/schemas/application-frame.schema.json",
  "title": "Ordered committed application frame",
  "type": "object",
  "properties": {
    "roomGeneration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "type": {
      "enum": [
        "score-set",
        "status-set",
        "announcement"
      ]
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "roomGeneration",
    "sequence",
    "type",
    "payload"
  ],
  "additionalProperties": false
}
