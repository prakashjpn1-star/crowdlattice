{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/crowdlattice/schemas/control-frame.schema.json",
  "title": "Heartbeat reset end or error frame",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "HEARTBEAT"
        },
        "serverTimeMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "serverTimeMs"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "RESET_REQUIRED"
        },
        "roomGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "snapshotSequence": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": [
        "type",
        "roomGeneration",
        "snapshotSequence",
        "reason"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "END"
        },
        "roomGeneration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "sequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "roomGeneration",
        "sequence"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "ERROR"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "retryAfterMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "code",
        "retryAfterMs"
      ],
      "additionalProperties": false
    }
  ]
}
