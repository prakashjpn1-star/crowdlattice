{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/crowdlattice/schemas/worker-map.schema.json",
  "title": "Complete versioned routing map",
  "type": "object",
  "properties": {
    "expectedRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "mapVersion": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "bucketCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    },
    "assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "bucket": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4095
          },
          "workerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "bucket",
          "workerId"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 4096
    }
  },
  "required": [
    "expectedRevision",
    "mapVersion",
    "bucketCount",
    "assignments"
  ],
  "additionalProperties": false
}
