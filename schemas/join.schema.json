{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prakashjpn1-star/crowdlattice/schemas/join.schema.json",
  "title": "Viewer join or reconnect request",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "roomGeneration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "lastAppliedSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expectedSessionGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "sessionId",
    "roomGeneration",
    "lastAppliedSequence"
  ],
  "additionalProperties": false
}
